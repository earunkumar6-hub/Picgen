# Copy this file to `.env` in the backend/ directory and fill in real values.
# Any provider left blank is simply disabled (its adapter won't be offered as a model choice).

# --- Prompt generation / enhancement (OpenAI) ---
OPENAI_API_KEY=

# --- Image generation providers ---
# OpenAI Images (gpt-image-2.5-flare) reuses OPENAI_API_KEY above.

# FLUX Pro via Replicate (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# Ideogram (https://ideogram.ai/manage-api)
IDEOGRAM_API_KEY=

# Google Imagen via Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Path to a service-account JSON key with Vertex AI User role
GOOGLE_APPLICATION_CREDENTIALS=

# --- App ---
DATABASE_URL=sqlite:///./picgen.db
STORAGE_DIR=./storage/images
CORS_ORIGINS=http://localhost:5173
